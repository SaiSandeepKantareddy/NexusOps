OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-me

NEXUSOPS_DEFAULT_MODEL=gpt-4.1
NEXUSOPS_FAST_MODEL=gpt-4.1-mini
NEXUSOPS_ROUTER_MODEL=gpt-4.1-mini
NEXUSOPS_EMBEDDING_MODEL=text-embedding-3-small

NEXUSOPS_SKILLS_DIR=skills
NEXUSOPS_LOOPS_DIR=loops
NEXUSOPS_BLUEPRINTS_DIR=blueprints
NEXUSOPS_RUNS_DIR=runs

# Keep Phoenix state inside the project instead of ~/.phoenix.
PHOENIX_WORKING_DIR=runs/phoenix
